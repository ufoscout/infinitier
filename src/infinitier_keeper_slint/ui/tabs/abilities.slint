import { KeyValue } from "../models.slint";
import { Section } from "../widgets/section.slint";

// The Abilities tab body — three columns of `Section` cards. Every
// section is just a flat list of (label, value) pairs computed on the
// Rust side, so this file knows nothing about the per-engine CRE
// layout.
export component AbilitiesTab inherits HorizontalLayout {
    in property <[KeyValue]> ability-scores;
    in property <[KeyValue]> combat-stats;
    in property <[KeyValue]> experience-levels;
    in property <[KeyValue]> morale-rows;
    in property <[KeyValue]> skill-rows;
    in property <string> skills-title;

    padding: 12px;
    spacing: 12px;

    VerticalLayout {
        spacing: 10px;
        horizontal-stretch: 1;
        Section { title: "Ability scores"; rows: ability-scores; }
        Section { title: "Combat & status"; rows: combat-stats; }
    }
    VerticalLayout {
        spacing: 10px;
        horizontal-stretch: 1;
        Section { title: "Experience & levels"; rows: experience-levels; }
        Section { title: "Morale"; rows: morale-rows; }
    }
    VerticalLayout {
        spacing: 10px;
        horizontal-stretch: 1;
        Section { title: skills-title; rows: skill-rows; }
    }
}
