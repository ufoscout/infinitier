// Data structs shared across the UI tree and between Rust and Slint.

// One label/value field row used inside every abilities section.
export struct KeyValue {
    label: string,
    value: string,
}

// One party-member entry in the left rail.
export struct PartyMember {
    display: string,
    has-cre: bool,
}

// Tab descriptor for the strip across the top of the character panel.
export struct TabLabel {
    name: string,
}
