import { Palette } from "std-widgets.slint";

// Image-resource viewer. Used for every raster type that ends up in
// `ImportedResource::Image` (BMP, PVRZ, MOS, PNG). The bitmap is
// uploaded once per selection on the Rust side via
// `slint::Image::from_rgba8_premultiplied` and exposed here through
// the `image` property.
//
// Bottom strip mirrors the egui viewer: pixel size, file size, format
// label, format description, origin.
export component ImageViewer inherits Rectangle {
    in property <image> image;
    in property <string> dims;
    in property <string> file-size;
    in property <string> format-label;
    in property <string> format-description;
    in property <string> origin;

    VerticalLayout {
        spacing: 0px;

        // Image area. Match the egui viewer's "shrink-to-fit, never
        // upscale" behaviour: cap each side of the Image element at
        // the natural pixel size so `image-fit: contain` only ever
        // scales down, never up.
        HorizontalLayout {
            vertical-stretch: 1;
            padding: 12px;
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                Image {
                    source: image;
                    image-fit: contain;
                    width: min(parent.width, self.source.width * 1px);
                    height: min(parent.height, self.source.height * 1px);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Bottom info bar
        Rectangle {
            height: 28px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 16px;
                alignment: start;
                Text { text: dims; color: Palette.foreground; vertical-alignment: center; }
                Rectangle { width: 1px; background: Palette.border; vertical-stretch: 1; }
                Text { text: file-size; color: Palette.foreground; vertical-alignment: center; }
                Rectangle { width: 1px; background: Palette.border; vertical-stretch: 1; }
                Text { text: format-label; color: Palette.foreground; vertical-alignment: center; font-weight: 700; }
                Rectangle { width: 1px; background: Palette.border; vertical-stretch: 1; }
                Text { text: format-description; color: Palette.foreground; vertical-alignment: center; opacity: 0.7; }
                Rectangle { width: 1px; background: Palette.border; vertical-stretch: 1; }
                Text { text: origin; color: Palette.foreground; vertical-alignment: center; opacity: 0.7; }
            }
        }
    }
}
