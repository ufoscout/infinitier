import { Palette, ComboBox, Slider, Button } from "std-widgets.slint";

// BAM animation viewer. The current cycle's `render_frame_centered`
// output is uploaded into `image` on the Rust side every time the
// selected (cycle, frame) pair changes; here we only paint.
export component BamViewer inherits Rectangle {
    in property <image> image;

    // Info bar text
    in property <string> dims;
    in property <string> frame-center;
    in property <string> file-size;
    in property <string> bam-type;
    in property <string> frames-text;
    in property <string> cycles-text;
    in property <string> origin;

    // Selectors. The cycle list and the current frame max come from
    // Rust on selection / cycle change.
    in property <[string]> cycle-options;
    in-out property <int> cycle-index;
    in property <int> frame-max;
    in-out property <int> frame-index;
    in property <string> global-frame-text;
    in property <bool> is-playing;
    in property <bool> can-play;

    callback cycle-changed(int);
    callback frame-changed(int);
    callback play-pause-clicked();

    VerticalLayout {
        // Frame area. Match the egui viewer's "shrink-to-fit, never
        // upscale" behaviour: cap each side of the Image element at
        // the natural pixel size so `image-fit: contain` only ever
        // scales down, never up.
        HorizontalLayout {
            vertical-stretch: 1;
            padding: 12px;
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                Image {
                    source: image;
                    image-fit: contain;
                    width: min(parent.width, self.source.width * 1px);
                    height: min(parent.height, self.source.height * 1px);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Selector strip
        Rectangle {
            height: 56px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 6px;
                spacing: 12px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: " ";
                        color: Palette.foreground;
                        opacity: 0;
                        font-size: 11px;
                    }
                    Button {
                        text: is-playing ? "⏸  Pause" : "▶  Play";
                        enabled: can-play;
                        clicked => { play-pause-clicked(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Cycle";
                        color: Palette.foreground;
                        opacity: 0.6;
                        font-size: 11px;
                    }
                    cycle-combo := ComboBox {
                        model: cycle-options;
                        current-index: cycle-index;
                        selected(_) => { cycle-changed(cycle-combo.current-index); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: "Frame " + frame-index + " / " + frame-max + "  " + global-frame-text;
                        color: Palette.foreground;
                        opacity: 0.6;
                        font-size: 11px;
                    }
                    frame-slider := Slider {
                        minimum: 0;
                        maximum: frame-max > 0 ? frame-max : 0;
                        value: frame-index;
                        enabled: frame-max > 0;
                        changed(_) => { frame-changed(round(frame-slider.value)); }
                    }
                }
            }
        }

        // Bottom info bar
        Rectangle {
            height: 28px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 16px;
                alignment: start;
                Text { text: dims; color: Palette.foreground; vertical-alignment: center; }
                Rectangle { width: 1px; background: Palette.border; vertical-stretch: 1; }
                Text { text: frame-center; color: Palette.foreground; vertical-alignment: center; }
                Rectangle { width: 1px; background: Palette.border; vertical-stretch: 1; }
                Text { text: file-size; color: Palette.foreground; vertical-alignment: center; }
                Rectangle { width: 1px; background: Palette.border; vertical-stretch: 1; }
                Text { text: bam-type; color: Palette.foreground; vertical-alignment: center; font-weight: 700; }
                Rectangle { width: 1px; background: Palette.border; vertical-stretch: 1; }
                Text { text: frames-text; color: Palette.foreground; vertical-alignment: center; opacity: 0.7; }
                Rectangle { width: 1px; background: Palette.border; vertical-stretch: 1; }
                Text { text: cycles-text; color: Palette.foreground; vertical-alignment: center; opacity: 0.7; }
                Rectangle { width: 1px; background: Palette.border; vertical-stretch: 1; }
                Text { text: origin; color: Palette.foreground; vertical-alignment: center; opacity: 0.7; }
            }
        }
    }
}
