import { Palette } from "std-widgets.slint";
import { TreeNode, TableRow, KeyValue } from "models.slint";
import { TreePanel } from "panels/tree.slint";
import { InfoPanel } from "panels/info.slint";
import { ViewerPanel } from "panels/viewer.slint";

export { Palette }
export { TreeNode, TableRow, KeyValue }

export component MainWindow inherits Window {
    title: window-title;
    preferred-width: 1400px;
    preferred-height: 800px;
    background: Palette.background;
    default-font-family: "sans-serif";

    in property <string> window-title: "Infinitier Explorer (Slint)";

    // Tree
    in property <[TreeNode]> tree-nodes: [];
    in property <int> tree-selected: -1;

    // Bottom info bar
    in property <string> info-message: "No file selected";

    // Viewer (forwarded straight to ViewerPanel)
    in property <string> viewer-kind: "empty";
    in property <string> message-text;

    // Image
    in property <image> image-bitmap;
    in property <string> image-dims;
    in property <string> image-file-size;
    in property <string> image-format-label;
    in property <string> image-format-description;
    in property <string> image-origin;

    // BAM
    in property <image> bam-bitmap;
    in property <string> bam-dims;
    in property <string> bam-frame-center;
    in property <string> bam-file-size;
    in property <string> bam-type;
    in property <string> bam-frames-text;
    in property <string> bam-cycles-text;
    in property <string> bam-origin;
    in property <[string]> bam-cycle-options;
    in-out property <int> bam-cycle-index;
    in property <int> bam-frame-max;
    in-out property <int> bam-frame-index;
    in property <string> bam-global-frame-text;
    in property <bool> bam-is-playing;
    in property <bool> bam-can-play;

    // BCS
    in property <string> bcs-baf;
    in property <string> bcs-file-size;
    in property <string> bcs-cr-blocks;
    in property <string> bcs-baf-lines;
    in property <string> bcs-origin;

    // FNT
    in property <[KeyValue]> fnt-rows;
    in property <string> fnt-note;
    in property <string> fnt-raw-dump;
    in property <string> fnt-file-size;
    in property <string> fnt-body-size;
    in property <string> fnt-origin;

    // Table
    in property <[string]> table-headers;
    in property <[TableRow]> table-rows;
    in property <string> table-title;
    in property <string> table-subtitle;

    // Sound
    in property <string> sound-name;
    in property <string> sound-format;
    in property <string> sound-info;
    in property <float> sound-progress;
    in property <string> sound-position-text;
    in property <string> sound-duration-text;
    in property <bool> sound-is-playing;
    in property <bool> sound-has-audio;
    in property <bool> sound-audio-missing;
    in property <string> sound-decode-error;

    // Movie
    in property <image> movie-bitmap;
    in property <string> movie-name;
    in property <string> movie-format;
    in property <string> movie-dims;
    in property <string> movie-fps;
    in property <float> movie-progress;
    in property <string> movie-position-text;
    in property <string> movie-duration-text;
    in property <bool> movie-is-playing;
    in property <bool> movie-has-movie;
    in property <string> movie-decode-error;

    // TIS
    in property <image> tis-bitmap;
    in property <string> tis-dims;
    in property <string> tis-file-size;
    in property <string> tis-variant;
    in property <string> tis-tile-count;
    in property <string> tis-grid-dims;
    in property <string> tis-origin;
    in property <string> tis-warning;
    in property <int> tis-columns;
    in property <int> tis-columns-min;
    in property <int> tis-columns-max;
    in property <bool> tis-show-grid;
    in property <int> tis-tile-dim;
    in property <[int]> tis-grid-vlines;
    in property <[int]> tis-grid-hlines;

    // Callbacks back into Rust
    callback node-clicked(int);
    callback bam-cycle-changed(int);
    callback bam-frame-changed(int);
    callback bam-play-pause-clicked();
    callback sound-play-pause-clicked();
    callback sound-stop-clicked();
    callback movie-play-pause-clicked();
    callback movie-stop-clicked();
    callback tis-columns-changed(int);
    callback tis-show-grid-changed(bool);

    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;
            TreePanel {
                nodes: root.tree-nodes;
                selected: root.tree-selected;
                clicked(i) => { root.node-clicked(i); }
            }
            Rectangle { width: 1px; background: Palette.border; }
            ViewerPanel {
                viewer-kind: root.viewer-kind;
                message-text: root.message-text;

                image-bitmap: root.image-bitmap;
                image-dims: root.image-dims;
                image-file-size: root.image-file-size;
                image-format-label: root.image-format-label;
                image-format-description: root.image-format-description;
                image-origin: root.image-origin;

                bam-bitmap: root.bam-bitmap;
                bam-dims: root.bam-dims;
                bam-frame-center: root.bam-frame-center;
                bam-file-size: root.bam-file-size;
                bam-type: root.bam-type;
                bam-frames-text: root.bam-frames-text;
                bam-cycles-text: root.bam-cycles-text;
                bam-origin: root.bam-origin;
                bam-cycle-options: root.bam-cycle-options;
                bam-cycle-index: root.bam-cycle-index;
                bam-frame-max: root.bam-frame-max;
                bam-frame-index: root.bam-frame-index;
                bam-global-frame-text: root.bam-global-frame-text;
                bam-is-playing: root.bam-is-playing;
                bam-can-play: root.bam-can-play;
                bam-cycle-changed(i) => { root.bam-cycle-changed(i); }
                bam-frame-changed(i) => { root.bam-frame-changed(i); }
                bam-play-pause-clicked => { root.bam-play-pause-clicked(); }

                bcs-baf: root.bcs-baf;
                bcs-file-size: root.bcs-file-size;
                bcs-cr-blocks: root.bcs-cr-blocks;
                bcs-baf-lines: root.bcs-baf-lines;
                bcs-origin: root.bcs-origin;

                fnt-rows: root.fnt-rows;
                fnt-note: root.fnt-note;
                fnt-raw-dump: root.fnt-raw-dump;
                fnt-file-size: root.fnt-file-size;
                fnt-body-size: root.fnt-body-size;
                fnt-origin: root.fnt-origin;

                table-headers: root.table-headers;
                table-rows: root.table-rows;
                table-title: root.table-title;
                table-subtitle: root.table-subtitle;

                sound-name: root.sound-name;
                sound-format: root.sound-format;
                sound-info: root.sound-info;
                sound-progress: root.sound-progress;
                sound-position-text: root.sound-position-text;
                sound-duration-text: root.sound-duration-text;
                sound-is-playing: root.sound-is-playing;
                sound-has-audio: root.sound-has-audio;
                sound-audio-missing: root.sound-audio-missing;
                sound-decode-error: root.sound-decode-error;
                sound-play-pause-clicked => { root.sound-play-pause-clicked(); }
                sound-stop-clicked => { root.sound-stop-clicked(); }

                movie-bitmap: root.movie-bitmap;
                movie-name: root.movie-name;
                movie-format: root.movie-format;
                movie-dims: root.movie-dims;
                movie-fps: root.movie-fps;
                movie-progress: root.movie-progress;
                movie-position-text: root.movie-position-text;
                movie-duration-text: root.movie-duration-text;
                movie-is-playing: root.movie-is-playing;
                movie-has-movie: root.movie-has-movie;
                movie-decode-error: root.movie-decode-error;
                movie-play-pause-clicked => { root.movie-play-pause-clicked(); }
                movie-stop-clicked => { root.movie-stop-clicked(); }

                tis-bitmap: root.tis-bitmap;
                tis-dims: root.tis-dims;
                tis-file-size: root.tis-file-size;
                tis-variant: root.tis-variant;
                tis-tile-count: root.tis-tile-count;
                tis-grid-dims: root.tis-grid-dims;
                tis-origin: root.tis-origin;
                tis-warning: root.tis-warning;
                tis-columns: root.tis-columns;
                tis-columns-min: root.tis-columns-min;
                tis-columns-max: root.tis-columns-max;
                tis-show-grid: root.tis-show-grid;
                tis-tile-dim: root.tis-tile-dim;
                tis-grid-vlines: root.tis-grid-vlines;
                tis-grid-hlines: root.tis-grid-hlines;
                tis-columns-changed(v) => { root.tis-columns-changed(v); }
                tis-show-grid-changed(v) => { root.tis-show-grid-changed(v); }
            }
        }
        Rectangle { height: 1px; background: Palette.border; }
        InfoPanel { message: root.info-message; }
    }
}
