import { Palette } from "std-widgets.slint";

// Bottom strip that mirrors the egui explorer's `selected_file_info`
// panel: shows the resource name + data origin of the current
// selection, or a placeholder when nothing is selected.
export component InfoPanel inherits Rectangle {
    in property <string> message;
    height: 28px;
    background: Palette.alternate-background;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: message;
            color: Palette.foreground;
            opacity: 0.85;
            vertical-alignment: center;
        }
    }
}
