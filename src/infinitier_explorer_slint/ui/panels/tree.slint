import { ListView, Palette } from "std-widgets.slint";
import { TreeNode } from "../models.slint";

// Left rail: flat list of TreeNode rows. Group headers have a
// triangle marker and an extension label; leaves are indented and
// show the resource name. Clicks fire `clicked(int)` carrying the row
// index into the flat list — Rust looks up whether it's a group or a
// leaf and acts accordingly.
export component TreePanel inherits Rectangle {
    in property <[TreeNode]> nodes;
    in property <int> selected;
    callback clicked(int);

    width: 280px;
    background: Palette.alternate-background;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Text {
            text: "Resources";
            color: Palette.foreground;
            font-weight: 700;
            font-size: 14px;
        }
        Rectangle { height: 1px; background: Palette.border; }
        ListView {
            for node[i] in nodes: Rectangle {
                height: 22px;
                background: i == selected && !node.is-group
                    ? Palette.accent-background
                    : transparent;
                HorizontalLayout {
                    padding-left: node.is-group ? 4px : 22px;
                    padding-right: 6px;
                    spacing: 4px;
                    if node.is-group: Text {
                        text: node.expanded ? "▾" : "▸";
                        color: Palette.foreground;
                        opacity: 0.7;
                        width: 12px;
                    }
                    Text {
                        text: node.label;
                        color: i == selected && !node.is-group
                            ? Palette.accent-foreground
                            : Palette.foreground;
                        font-weight: node.is-group ? 700 : 400;
                        overflow: elide;
                    }
                }
                TouchArea { clicked => { clicked(i); } }
            }
        }
    }
}
