import { Palette } from "std-widgets.slint";
import { TableRow, KeyValue } from "../models.slint";
import { MessageViewer } from "../viewers/message.slint";
import { ImageViewer } from "../viewers/image.slint";
import { BamViewer } from "../viewers/bam.slint";
import { BcsViewer } from "../viewers/bcs.slint";
import { FntViewer } from "../viewers/fnt.slint";
import { TableViewer } from "../viewers/table.slint";
import { SoundViewer } from "../viewers/sound.slint";
import { MovieViewer } from "../viewers/movie.slint";
import { TisViewer } from "../viewers/tis.slint";

// Right pane: a single conditional view driven by `viewer-kind`.
//
// `viewer-kind` is a string set by Rust on every selection — the
// dispatcher in `src/ui/viewer.rs` decides which inner viewer to show
// and populates the relevant property block first.
export component ViewerPanel inherits Rectangle {
    in property <string> viewer-kind: "empty";
    in property <string> message-text;

    // Image
    in property <image> image-bitmap;
    in property <string> image-dims;
    in property <string> image-file-size;
    in property <string> image-format-label;
    in property <string> image-format-description;
    in property <string> image-origin;

    // BAM
    in property <image> bam-bitmap;
    in property <string> bam-dims;
    in property <string> bam-frame-center;
    in property <string> bam-file-size;
    in property <string> bam-type;
    in property <string> bam-frames-text;
    in property <string> bam-cycles-text;
    in property <string> bam-origin;
    in property <[string]> bam-cycle-options;
    in-out property <int> bam-cycle-index;
    in property <int> bam-frame-max;
    in-out property <int> bam-frame-index;
    in property <string> bam-global-frame-text;
    in property <bool> bam-is-playing;
    in property <bool> bam-can-play;
    callback bam-cycle-changed(int);
    callback bam-frame-changed(int);
    callback bam-play-pause-clicked();

    // BCS
    in property <string> bcs-baf;
    in property <string> bcs-file-size;
    in property <string> bcs-cr-blocks;
    in property <string> bcs-baf-lines;
    in property <string> bcs-origin;

    // FNT
    in property <[KeyValue]> fnt-rows;
    in property <string> fnt-note;
    in property <string> fnt-raw-dump;
    in property <string> fnt-file-size;
    in property <string> fnt-body-size;
    in property <string> fnt-origin;

    // Table (2DA, IDS, INI)
    in property <[string]> table-headers;
    in property <[TableRow]> table-rows;
    in property <string> table-title;
    in property <string> table-subtitle;

    // Sound
    in property <string> sound-name;
    in property <string> sound-format;
    in property <string> sound-info;
    in property <float> sound-progress;
    in property <string> sound-position-text;
    in property <string> sound-duration-text;
    in property <bool> sound-is-playing;
    in property <bool> sound-has-audio;
    in property <bool> sound-audio-missing;
    in property <string> sound-decode-error;
    callback sound-play-pause-clicked();
    callback sound-stop-clicked();

    // Movie
    in property <image> movie-bitmap;
    in property <string> movie-name;
    in property <string> movie-format;
    in property <string> movie-dims;
    in property <string> movie-fps;
    in property <float> movie-progress;
    in property <string> movie-position-text;
    in property <string> movie-duration-text;
    in property <bool> movie-is-playing;
    in property <bool> movie-has-movie;
    in property <string> movie-decode-error;
    callback movie-play-pause-clicked();
    callback movie-stop-clicked();

    // TIS
    in property <image> tis-bitmap;
    in property <string> tis-dims;
    in property <string> tis-file-size;
    in property <string> tis-variant;
    in property <string> tis-tile-count;
    in property <string> tis-grid-dims;
    in property <string> tis-origin;
    in property <string> tis-warning;
    in property <int> tis-columns;
    in property <int> tis-columns-min;
    in property <int> tis-columns-max;
    in property <bool> tis-show-grid;
    in property <int> tis-tile-dim;
    in property <[int]> tis-grid-vlines;
    in property <[int]> tis-grid-hlines;
    callback tis-columns-changed(int);
    callback tis-show-grid-changed(bool);

    background: Palette.background;
    horizontal-stretch: 1;

    if viewer-kind == "empty": MessageViewer {
        text: "Select a resource from the panel on the left.";
    }
    if viewer-kind == "message": MessageViewer { text: message-text; }
    if viewer-kind == "image": ImageViewer {
        image: image-bitmap;
        dims: image-dims;
        file-size: image-file-size;
        format-label: image-format-label;
        format-description: image-format-description;
        origin: image-origin;
    }
    if viewer-kind == "bam": BamViewer {
        image: bam-bitmap;
        dims: bam-dims;
        frame-center: bam-frame-center;
        file-size: bam-file-size;
        bam-type: bam-type;
        frames-text: bam-frames-text;
        cycles-text: bam-cycles-text;
        origin: bam-origin;
        cycle-options: bam-cycle-options;
        cycle-index: bam-cycle-index;
        frame-max: bam-frame-max;
        frame-index: bam-frame-index;
        global-frame-text: bam-global-frame-text;
        is-playing: bam-is-playing;
        can-play: bam-can-play;
        cycle-changed(i) => { bam-cycle-changed(i); }
        frame-changed(i) => { bam-frame-changed(i); }
        play-pause-clicked => { bam-play-pause-clicked(); }
    }
    if viewer-kind == "bcs": BcsViewer {
        baf: bcs-baf;
        file-size: bcs-file-size;
        cr-blocks: bcs-cr-blocks;
        baf-lines: bcs-baf-lines;
        origin: bcs-origin;
    }
    if viewer-kind == "fnt": FntViewer {
        rows: fnt-rows;
        note: fnt-note;
        raw-dump: fnt-raw-dump;
        file-size: fnt-file-size;
        body-size: fnt-body-size;
        origin: fnt-origin;
    }
    if viewer-kind == "table": TableViewer {
        headers: table-headers;
        rows: table-rows;
        title: table-title;
        subtitle: table-subtitle;
    }
    if viewer-kind == "sound": SoundViewer {
        name: sound-name;
        format: sound-format;
        info: sound-info;
        progress: sound-progress;
        position-text: sound-position-text;
        duration-text: sound-duration-text;
        is-playing: sound-is-playing;
        has-audio: sound-has-audio;
        audio-missing: sound-audio-missing;
        decode-error: sound-decode-error;
        play-pause-clicked => { sound-play-pause-clicked(); }
        stop-clicked => { sound-stop-clicked(); }
    }
    if viewer-kind == "tis": TisViewer {
        bitmap: tis-bitmap;
        dims: tis-dims;
        file-size: tis-file-size;
        variant: tis-variant;
        tile-count: tis-tile-count;
        grid-dims: tis-grid-dims;
        origin: tis-origin;
        warning: tis-warning;
        columns: tis-columns;
        columns-min: tis-columns-min;
        columns-max: tis-columns-max;
        show-grid: tis-show-grid;
        tile-dim: tis-tile-dim;
        grid-vlines: tis-grid-vlines;
        grid-hlines: tis-grid-hlines;
        columns-changed(v) => { tis-columns-changed(v); }
        show-grid-changed(v) => { tis-show-grid-changed(v); }
    }
    if viewer-kind == "movie": MovieViewer {
        bitmap: movie-bitmap;
        name: movie-name;
        format: movie-format;
        dims: movie-dims;
        fps: movie-fps;
        progress: movie-progress;
        position-text: movie-position-text;
        duration-text: movie-duration-text;
        is-playing: movie-is-playing;
        has-movie: movie-has-movie;
        decode-error: movie-decode-error;
        play-pause-clicked => { movie-play-pause-clicked(); }
        stop-clicked => { movie-stop-clicked(); }
    }
}
